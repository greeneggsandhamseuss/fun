import random                                                                      # Imports Python's built-in random number module

secret_number = random.randint(1, 100)                                             # Picks a random integer between 1 and 100
attempts = 0                                                                       # Tracks how many guesses the player makes
guess = 0                                                                          # Stores the player's current guess (initialized to 0 so the loop starts)

print("Welcome to the Number Guessing Game!")                                      # Prints the welcome message
print("I am thinking of a number between 1 and 100. Try to guess it!")             # Explains the rules to the player
print()                                                                            # Prints a blank line for spacing


while guess != secret_number:                                                      # Repeats the game loop until the guess matches the secret number
    user_input = input("Pick a number from 1-100: ")                               # Prompts the user and saves their typed answer as text

    if not user_input.isdigit():                                                   # Checks if the input contains anything other than digits
        print("Please enter a valid whole number.")                                # Warns the user if they typed letters, symbols, or negatives
        print()                                                                    # Prints a blank line for spacing
        continue                                                                   # Skips the rest of the loop and asks for input again

    guess = int(user_input)                                                        # Converts the valid text input into an integer
    attempts = attempts + 1                                                        # Adds 1 to the total attempt counter

    if guess < secret_number:                                                      # Checks if the guess is smaller than the secret number
        print("Too low! Try again.")                                               # Gives a hint to guess higher
    elif guess > secret_number:                                                    # Checks if the guess is larger than the secret number
        print("Too high! Try again.")                                              # Gives a hint to guess lower
    else:                                                                          # Runs when the guess is neither higher nor lower (it matches!)
        print()                                                                    # Prints a blank line for spacing
        print(f"Correct! It was {secret_number}!")                                 # Congratulates the player and reveals the number
        print(f"You got it in {attempts} tries!")                                  # Displays the total number of guesses taken
        print()                                                                    # Prints a blank line for spacing